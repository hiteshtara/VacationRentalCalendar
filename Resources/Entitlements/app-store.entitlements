<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mac App Store (sandboxed) entitlements. NOT YET USED.

  Kept beside the Developer ID file so the difference between the two paths is
  visible in one diff rather than argued about later. Enabling the sandbox
  relocates the application's data into ~/Library/Containers, which is a
  migration that has not been written — see docs/DISTRIBUTION.md, Stage 3.

  network.client is required: the app fetches three iCalendar feeds over HTTPS
  and, optionally, an AWS endpoint. It needs no server, no camera, no
  microphone, no address book, no location, and no user-selected file access
  unless calendar export is kept.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.vacationrentalcalendar.shared</string>
    </array>
</dict>
</plist>
