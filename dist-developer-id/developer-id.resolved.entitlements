<?xml version="1.0" encoding="UTF-8"?>
<!--
  Developer ID (notarized, unsandboxed) entitlements.

  Only one entitlement, and it is the one that fixes the recurring breakage:
  a keychain access group. The group belongs to the signing TEAM, so the app
  and its bundled `vrc` helper share credentials and a rebuild no longer
  orphans them. See docs/DISTRIBUTION.md.

  Deliberately absent:
    * com.apple.security.app-sandbox — that is the App Store path, and a
      separate file, because sandboxing relocates the database container.
    * com.apple.security.cs.disable-library-validation — the helper is signed
      by the same team, so library validation is satisfied without weakening it.
    * com.apple.security.cs.allow-unsigned-executable-memory, allow-jit,
      allow-dyld-environment-variables — nothing here needs them, and each one
      is a question at notarization that is better never raised.
-->
<plist version="1.0">
<dict>
    <key>keychain-access-groups</key>
    <array>
        <string>26JLFSV9YS.com.vacationrentalcalendar.shared</string>
    </array>
</dict>
</plist>
